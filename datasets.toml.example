# Dataset alias → path (and optional per-dataset parameters).
# Copy to datasets.toml and fill in your local paths.
#
# Set DATABENCH_DATASET env var to pick one:
#   DATABENCH_DATASET=etoh python Scripts/event-based.py
# If unset, the "default" alias is used.

default = "etoh-hfsa"

[datasets]
# Shorthand: alias → path.  Use this when you only need a path.
acutevis  = "/path/to/260212_ACUTEVIS_dataset.pkl"
etoh-hfsa = "/path/to/260212_ETOH-HFSA_dataset.pkl"

# Rich form: arbitrary user-defined keys are exposed as ``proj.params``.
# Only ``path`` is required.  All other keys are passed through unchanged.
[datasets.etoh]
path = "/path/to/260211_ETOH_dataset.pkl"
session_map = { "ses-01" = "baseline", "ses-02" = "saline", "ses-03" = "ethanol_low", "ses-04" = "ethanol_high" }
condition_order = ["baseline", "saline", "ethanol_low", "ethanol_high"]
condition_colors = { baseline = "#bbabab", saline = "#4289e6", ethanol_low = "#ffa251", ethanol_high = "#ce1818" }

# In a script:
#   proj = Project("etoh")          # alias-string form
#   session_map      = proj.params["session_map"]
#   condition_order  = proj.params["condition_order"]
#   condition_colors = proj.params["condition_colors"]

# ── Schema (optional but recommended) ───────────────────────────────────
#
# The schema makes a dataset self-describing.  Two sub-tables:
#
#   [datasets.<alias>.sources]
#     alias  = canonical_key
#   [datasets.<alias>.schema]
#     "canonical_key.column" = { role = "...", unit = "..." }
#
# Source aliases let scripts written against one dataset's naming
# (e.g. source="pupil") work unchanged on a dataset that keys the same
# data as "pupil_dlc".  Column specs give Project.describe() and
# databench.plotting.quickplot enough metadata to label axes and pick a
# sensible default plot type.  Roles: "timeseries", "event", "scalar",
# "time".  Unknown columns are tolerated; only declare what you use.

[datasets.hfsa]
path = "/path/to/260513_HFSA.pkl"

[datasets.hfsa.sources]
pupil = "pupil_dlc"     # scripts using source="pupil" resolve to "pupil_dlc"

[datasets.hfsa.schema]
"pupil_dlc.pupil_diameter_mm"  = { role = "timeseries", unit = "mm"   }
"treadmill.speed_mm"           = { role = "timeseries", unit = "mm/s" }
"treadmill.time_elapsed_s"     = { role = "time",       unit = "s"    }
